# Copy to `.env.local` (gitignored) and fill in what your machine needs.
# `docs/setup.md` §2 explains when each variable applies.

# Port of the PHP backend. The host is taken from the Expo dev server, so the
# app follows the network (home, hotspot, emulator) without touching this file.
# The local Docker stack serves the backend on 8000.
EXPO_PUBLIC_API_PORT=8000

# Explicit API address: wins over the port above. Only for a tunnel, a built
# bundle, or a dev server that is not on the machine running the backend.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000

# There is no fake-data switch: the app always talks to the real backend
# (`docs/decisions.md` D011).
